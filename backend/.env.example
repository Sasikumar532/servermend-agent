PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/servermend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=test
# Optional. Without it, POST /servers/:id/findings/:checkId/remediation
# still works — it falls back to a deterministic template built from
# checkCatalog.js instead of calling the LLM.
ANTHROPIC_API_KEY=
