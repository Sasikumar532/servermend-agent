PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/servermend
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=test
# Optional. Without it, POST /servers/:id/findings/:checkId/remediation
# still works — it falls back to a deterministic template built from
# checkCatalog.js instead of calling the LLM.
ANTHROPIC_API_KEY=
# Optional. Without SMTP_HOST, new-critical-finding alerts are still
# recorded (see GET /servers/:id/alerts) — they just aren't emailed;
# emailStatus on each alert is "skipped_no_smtp" instead of "sent".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@servermend.local
